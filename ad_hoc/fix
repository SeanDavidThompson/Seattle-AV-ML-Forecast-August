library(data.table)
sgs <- c("apt","office","industrial","retail","hospitality","medical")

cmp <- rbindlist(lapply(sgs, function(sg) {
  old <- sprintf("./data/cache/panel_tbl_2006_2031_forecasted_PREecondrop_baseline_%s.rds", sg)
  new <- sprintf("./data/cache/panel_tbl_2006_2031_forecasted_baseline_%s.rds", sg)
  if (!file.exists(old) || !file.exists(new)) return(NULL)
  g <- function(f) {
    d <- readRDS(f); setDT(d); d[, tax_yr := as.integer(tax_yr)]
    d[tax_yr >= 2027, .(imps = sum(pred_appr_imps_val, na.rm = TRUE)), by = tax_yr][order(tax_yr)]
  }
  a <- g(old); b <- g(new)
  data.table(subgroup = sg,
             before_cum = round(100 * (a[["imps"]][5] / a[["imps"]][1] - 1), 2),
             after_cum  = round(100 * (b[["imps"]][5] / b[["imps"]][1] - 1), 2))
}))
cmp[, change_pp := round(after_cum - before_cum, 2)]
print(cmp)
