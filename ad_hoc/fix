# ---- ML origin 2025 (anchored + unanchored) vs old 2025 vintages, TY2026 ----
library(tidyr)
stopifnot(exists("old"), exists("read_bt"), exists("group_map"))

gy25 <- as_tibble(read_bt("growth_by_year.csv")) |>
  filter(pop == "seed_observed", origin == 2025, tax_yr == 2026, horizon == 1)
print(count(gy25, anchored))   # expect TRUE and FALSE, one row per track each

base25   <- gy25 |> filter(anchored)  |> select(track, av_base, act_g = g_act, ml_anch_g = g_pred)
unanch25 <- gy25 |> filter(!anchored) |> select(track, ml_unanch_g = g_pred)

cmp2 <- old |>
  mutate(track = unname(group_map[group])) |>
  filter(!is.na(track), tax_yr == 2026) |>
  inner_join(base25, by = "track") |>
  left_join(unanch25, by = "track") |>
  mutate(old_diff_B       = av_base * (old_g       - act_g) / 1e9,
         ml_anch_diff_B   = av_base * (ml_anch_g   - act_g) / 1e9,
         ml_unanch_diff_B = av_base * (ml_unanch_g - act_g) / 1e9)

# 1) Growth rates (%): actual, each old vintage, ML anchored, ML unanchored
cmp2 |>
  select(group, vintage, act_g, old_g, ml_anch_g, ml_unanch_g) |>
  pivot_wider(names_from = vintage, values_from = old_g) |>
  mutate(across(where(is.double), \(x) round(100 * x, 2))) |>
  print(n = Inf)

# 2) Dollar miss ($B, forecast minus actual) on the same TY2025 base
cmp2 |>
  select(group, vintage, old_diff_B, ml_anch_diff_B, ml_unanch_diff_B) |>
  pivot_wider(names_from = vintage, values_from = old_diff_B) |>
  mutate(across(where(is.double), \(x) round(x, 2))) |>
  print(n = Inf)

# 3) Totals: net and gross, with and without Hotels
tot_old <- cmp2 |>
  group_by(model = vintage) |>
  summarise(net_B = sum(old_diff_B), gross_B = sum(abs(old_diff_B)),
            gross_ex_hotels_B = sum(abs(old_diff_B[group != "Hotels"])), .groups = "drop")
one <- cmp2 |> filter(vintage == first(vintage))
tot_ml <- tibble(
  model             = c("ML anchored", "ML unanchored"),
  net_B             = c(sum(one$ml_anch_diff_B), sum(one$ml_unanch_diff_B)),
  gross_B           = c(sum(abs(one$ml_anch_diff_B)), sum(abs(one$ml_unanch_diff_B))),
  gross_ex_hotels_B = c(sum(abs(one$ml_anch_diff_B[one$group != "Hotels"])),
                        sum(abs(one$ml_unanch_diff_B[one$group != "Hotels"]))))
bind_rows(tot_old, tot_ml) |> mutate(across(where(is.double), \(x) round(x, 2))) |> print()

fwrite(cmp2, here("data", "outputs", "backtest", "old2025_vs_ml2025_ty2026.csv"))
