+                                           old = old, new = nw, stringsAsFactors = FALSE)
+   }
+   for (i in which(!kn %in% kb)) add("added", new[i, , drop = FALSE])
+   for (i in which(!kb %in% kn)) add("removed", base[i, , drop = FALSE])
