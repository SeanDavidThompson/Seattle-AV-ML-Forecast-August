score_vintages <- function(df) {
  act <- df |>
    filter(vintage == max(vintage)) |>
    select(tax_year, act = av)

  df |>
    mutate(vy = as.integer(substr(vintage, 1, 4)),
           horizon = tax_year - vy) |>
    filter(horizon %in% 1:2) |>
    left_join(act, by = "tax_year") |>
    left_join(rename(act, base = act), by = c("vy" = "tax_year")) |>
    filter(!is.na(act), !is.na(base)) |>
    mutate(g_pred     = 100 * (av  / base - 1),
           g_act      = 100 * (act / base - 1),
           cum_err_pp = g_pred - g_act) |>
    select(vintage, tax_year, horizon, g_pred, g_act, cum_err_pp)
}

