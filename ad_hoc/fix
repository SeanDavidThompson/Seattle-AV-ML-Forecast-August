+   kb <- kstr(base); kn <- kstr(new)
+   cols <- setdiff(union(names(base), names(new)), c(key, AR_CMP_SKIP))
+ 
+   out <- list()
+   add <- function(kind, row, col = NA_character_, old = NA_character_, nw = NA_character_) {
