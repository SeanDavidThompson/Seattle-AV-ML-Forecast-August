> # Left-pad all-digit ids with zeros ("160" -> "000160")
> pad0 <- function(x, w) {
+   x <- trimws(as.character(x))
+   short <- !is.na(x) & nchar(x) < w & grepl("^[0-9]+\\z", x, perl = TRUE)
+   x[short] <- paste0(strrep("0", w - nchar(x[short])), x[short])
+   x
+ }
