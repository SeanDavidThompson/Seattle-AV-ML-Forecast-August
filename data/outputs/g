> # What are they?  EXTR_Parcel PropType for the overlapping parcels
> pp <- here::here("data", "kca", get0("kca_date_data_extracted", ifnotfound = NA), "EXTR_Parcel.csv")
> if (file.exists(pp)) {
+     xp <- fread(pp, select = c("Major", "Minor", "PropType", "PresentUse"), colClasses = "character")
+     xp[, pid := paste0(formatC(Major, width = 6, flag = "0"), formatC(Minor, width = 4, flag = "0"))]
+     ov <- merge(ov, unique(xp[, .(pid, PropType, PresentUse)], by = "pid"), by = "pid", all.x = TRUE)
+     print(ov[, .(parcels = .N, av_res_B = sum(av_res, na.rm = TRUE) / 1e9), by = PropType][order(-parcels)])
+     print(ov[, .(parcels = .N, av_res_B = sum(av_res, na.rm = TRUE) / 1e9), by = PresentUse][order(-parcels)][1:15])
+ } else cat("(EXTR_Parcel.csv not found - set kca_date_data_extracted to break the overlap down by PropType)\n")
